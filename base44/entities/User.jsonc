{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "is_gold": {
      "type": "boolean",
      "default": false,
      "description": "PikaBoo Gold subscriber"
    },
    "gold_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When gold subscription expires"
    }
  }
}