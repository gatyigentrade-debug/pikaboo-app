{
  "name": "SwipeAction",
  "type": "object",
  "properties": {
    "swiper_id": {
      "type": "string"
    },
    "swiped_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "like",
        "dislike",
        "super_like"
      ]
    }
  },
  "required": [
    "swiper_id",
    "swiped_id",
    "action"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}