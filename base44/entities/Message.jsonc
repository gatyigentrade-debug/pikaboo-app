{
  "name": "Message",
  "type": "object",
  "properties": {
    "match_id": {
      "type": "string",
      "description": "Match record ID this message belongs to"
    },
    "sender_id": {
      "type": "string",
      "description": "User ID of the sender"
    },
    "recipient_id": {
      "type": "string",
      "description": "User ID of the recipient"
    },
    "text": {
      "type": "string"
    },
    "image_url": {
      "type": "string",
      "description": "URL of an attached image (optional)"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "match_id",
    "sender_id",
    "recipient_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        }
      ]
    }
  }
}