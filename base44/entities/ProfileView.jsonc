{
  "name": "ProfileView",
  "type": "object",
  "properties": {
    "viewer_profile_id": {
      "type": "string"
    },
    "viewed_profile_id": {
      "type": "string"
    },
    "viewer_name": {
      "type": "string"
    },
    "viewer_photo": {
      "type": "string"
    },
    "viewer_age": {
      "type": "number"
    },
    "viewer_city": {
      "type": "string"
    }
  },
  "required": [
    "viewer_profile_id",
    "viewed_profile_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}