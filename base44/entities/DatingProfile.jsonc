{
  "name": "DatingProfile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name \u2014 only the first name is ever shown to other users"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Date of birth. Age is always derived from this, never entered directly"
    },
    "age": {
      "type": "number",
      "description": "Age derived from date_of_birth when the profile is saved"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "non-binary"
      ]
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs of photos the user uploaded \u2014 never seeded or default images"
    },
    "bio": {
      "type": "string",
      "description": "Short bio"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Interest tags the user picked for their profile"
    },
    "braai_starter": {
      "type": "string",
      "description": "One-line braai starter conversation piece"
    },
    "home_language": {
      "type": "string",
      "enum": [
        "English",
        "isiZulu",
        "Afrikaans",
        "isiXhosa",
        "Sesotho",
        "Setswana",
        "Sepedi",
        "Xitsonga",
        "siSwati",
        "Tshivenda",
        "isiNdebele"
      ]
    },
    "city": {
      "type": "string"
    },
    "favorite_kota_spot": {
      "type": "string"
    },
    "sports_team": {
      "type": "string"
    },
    "braai_role": {
      "type": "string",
      "enum": [
        "Fire Maker",
        "Salady",
        "Grill Master",
        "Braai Boss"
      ]
    },
    "dream_date_location": {
      "type": "string"
    },
    "cant_live_without": {
      "type": "string"
    },
    "spirit_animal": {
      "type": "string",
      "enum": [
        "Springbok",
        "Dassie",
        "Hadeda",
        "Honey Badger",
        "Pangolin"
      ]
    },
    "is_verified": {
      "type": "boolean",
      "default": false,
      "description": "Set only by the real verification flow, together with verification_status = verified"
    },
    "verification_status": {
      "type": "string",
      "enum": [
        "not_submitted",
        "pending",
        "verified"
      ],
      "default": "not_submitted",
      "description": "Profile photo verification status"
    },
    "verification_photo": {
      "type": "string",
      "description": "URL of the photo submitted for verification"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "is_online": {
      "type": "boolean",
      "default": false
    },
    "looking_for": {
      "type": "string",
      "enum": [
        "relationship",
        "friendship",
        "casual",
        "not_sure"
      ]
    },
    "is_vip": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user has an active VIP subscription"
    },
    "vip_plan": {
      "type": "string",
      "enum": [
        "none",
        "weekly",
        "monthly",
        "quarterly"
      ],
      "default": "none",
      "description": "Active VIP subscription plan"
    },
    "vip_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the current VIP subscription expires"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}