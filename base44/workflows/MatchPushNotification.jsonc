{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Match"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "match_push_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_match_push": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendMatchPush",
            "args": {
              "match_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send match push",
            "description": "Notify the matched user"
          }
        }
      }
    ]
  },
  "description": "Sends a native push notification to the matched user when a new match is created",
  "name": "Match Push Notification"
}