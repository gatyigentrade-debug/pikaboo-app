{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Message"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "message_push_notification",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_message_push": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendMessagePush",
            "args": {
              "message_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send message push",
            "description": "Notify the recipient"
          }
        }
      }
    ]
  },
  "description": "Sends a native push notification to the recipient when a new message is created",
  "name": "Message Push Notification"
}